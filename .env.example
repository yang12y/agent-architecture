# ============================================================================
# yzy-agent 配置模板
#
# 用法：复制成 .env 再按需填写 ——  cp .env.example .env
# .env 已被 .gitignore 忽略；本文件会提交，所以不要在这里放真实密钥。
#
# 读取方式：infra/config/loader.py 读环境变量，前缀 YZY_、全大写、下划线分隔。
# 留空 = 用 infra/config/defaults.py 里的默认值。
# 优先级：真实环境变量 > .env > 代码默认值。
# ============================================================================


# ---------------------------------------------------------------------------
# 一、需要你填的
# ---------------------------------------------------------------------------

# 主模型标识。deepseek-flash（V4.1 Flash）与 deepseek-v4-pro 的上下文都是 1M。
# 留空 = 退回默认值 deepseek-flash。
YZY_MODEL=

# 生成压缩摘要用的模型，通常挑更便宜的那个。
# 留空 = 复用主模型。
YZY_SUMMARY_MODEL=

# 模型服务的 API Key。这是密钥，只写在本文件里，不要提交、不要贴进聊天。
# 没配的话，建客户端时会直接报 ConfigError，不会等到第一次请求才失败。
YZY_LLM_API_KEY=

# 模型服务的接入地址，用于 OpenAI 兼容端点或自建网关。
# 留空 = 用所选 provider 的官方地址。
YZY_LLM_BASE_URL=


# ---------------------------------------------------------------------------
# 二、路径
# ---------------------------------------------------------------------------

# 工作目录，同时也是沙箱根：文件类工具只能在这个目录树内读写。
YZY_WORKSPACE=

# 会话日志目录。
# 留空 = <workspace>/.data/sessions
YZY_SESSION_DIR=



# ---------------------------------------------------------------------------
# 三、权限与预算
# ---------------------------------------------------------------------------

# 权限档位，三选一：
#   read_only     只能读；写文件、执行命令一律拒绝
#   editable      允许在工作目录内读写文件，不允许执行任意命令
#   full_access   允许执行命令、访问网络，风险最高
# 留空 = editable
YZY_PERMISSION=editable

# 上下文窗口上限（token）。deepseek-flash 的窗口是 1M，这里按窗口给。
YZY_MAX_TOKENS=1000000

# 单次 trace 的最大 turn 数。**留空 = 不限**，长任务才能一口气跑完。
# 别随手填个小数字：撞上上限那次 trace 会以 budget_exceeded 收尾，活干一半就停。
# 真正兜住的是压缩阈值（YZY_COMPACT_RATIO）和界面上的停止键。
YZY_MAX_TURNS=

# 压缩阈值：占上下文窗口的比例。0.7 表示到窗口的七成就开始压。
# 只有比例，没有绝对值 —— 上面改了 YZY_MAX_TOKENS，阈值自动跟着走。
# 必须在 0 与 1 之间，否则启动时直接报错。
YZY_COMPACT_RATIO=0.7


# ---------------------------------------------------------------------------
# 四、压缩细节
# ---------------------------------------------------------------------------

# 二级压缩（滑动窗口 + 摘要）保留的最后 n 条 message 条目，其余被摘要取代。
YZY_KEEP_RECENT=20

# 单条工具结果最多留多少个字符，超出直接丢弃（只截断，不留原文、不留引用）。
# 这是**新建会话时抄给它的默认值**：会话自己那一份随会话落盘，改这里不影响已有会话。
YZY_TOOL_RESULT_MAX_CHARS=60000

# 单条工具结果超过多少 token 算「长」，是压缩第一级的判定标准。
YZY_LONG_TOOL_RESULT_MAX_TOKENS=2000

# 最近几条长工具结果保留原文、不做占位替换。
YZY_LONG_TOOL_RESULT_KEEP_RECENT=10

# 摘要提示词模板。这是多行文本，不建议写进 .env。
# 留空 = 用 infra/config/defaults.py 里的 DEFAULT_SUMMARY_PROMPT。
YZY_SUMMARY_PROMPT=


# ---------------------------------------------------------------------------
# 五、模型调用
# ---------------------------------------------------------------------------

# 单次模型请求的超时秒数。
# 留空 = 60
YZY_LLM_TIMEOUT=60

# 是否让模型开思考模式（推理模型才有用）。
#   true    打开：每轮多花一段思考的 token，界面上能看到折叠的"思考过程"
#   false   关闭（默认）
# 注意：带 tools 的请求必须把上一轮的思考原样传回去，这件事框架自己做了。
YZY_THINKING=false

# 单轮模型调用最多尝试几次（含首次）。重试只在"这次尝试还没产出任何内容"时发生，
# 已经吐出半截就不再重试（半截输出会留作"上一轮被打断的输出"）。
# 留空 = 3
YZY_LLM_MAX_ATTEMPTS=3


# ---------------------------------------------------------------------------
# 六、其他
# ---------------------------------------------------------------------------

# 指定 .env 的位置（相对当前工作目录）。设成空串表示不读任何 .env 文件。
# 留空 = 项目根目录下的 .env
YZY_ENV_FILE=

# 日志级别，五选一：DEBUG / INFO / WARNING / ERROR / CRITICAL
YZY_LOG_LEVEL=INFO
